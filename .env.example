# Public URL of this site (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://speediq.ai

# Where the product lives. Every Log in / Get started / Dashboard link points here.
NEXT_PUBLIC_APP_URL=https://app.speediq.ai

# Optional. Public key of a SpeedIQ live-chat widget (Dashboard → Live Chat).
# When set, the standard embed script is loaded like on any customer website.
# Leave empty to run the site with no runtime calls to the app at all.
NEXT_PUBLIC_SPEEDIQ_CHAT_KEY=
